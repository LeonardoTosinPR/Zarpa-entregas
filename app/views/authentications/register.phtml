<h5 class="text-center mb-4">Criar conta</h5>

<form action="<?= route('users.create') ?>" method="POST">
    <div class="mb-3">
        <label class="form-label">Nome</label>
        <input type="text" name="user[name]"
               class="form-control <?= $user->errors('name') ? 'is-invalid' : '' ?>"
               value="<?= htmlspecialchars($user->name ?? '') ?>" required autofocus>
        <?php if ($user->errors('name')) : ?>
            <div class="invalid-feedback"><?= $user->errors('name') ?></div>
        <?php endif; ?>
