<?php
use App\Models\Order;

$isDeliverer = $this->current_user->isDeliverer();
$isAdmin = $this->current_user->isAdmin();
$totalOrders = count($orders);
$pendingOrders = count(array_filter($orders, fn($order) => $order->status === Order::STATUS_PENDING));
$activeOrders = count(array_filter($orders, fn($order) => in_array($order->status, [Order::STATUS_ACCEPTED, Order::STATUS_ON_ROUTE], true)));
$deliveredOrders = count(array_filter($orders, fn($order) => $order->status === Order::STATUS_DELIVERED));
$heroText = $isAdmin
    ? 'Voce tem acesso administrativo para acompanhar usuarios, pedidos e a operacao completa.'
    : ($isDeliverer
    ? 'Seu acesso esta pronto para receber corridas, acompanhar rotas e organizar entregas na mobilete.'
    : 'Seu acesso esta pronto para criar pedidos, acompanhar coletas e enviar itens pela cidade.');
$primaryMetric = $isAdmin ? 'Pedidos totais' : ($isDeliverer ? 'Corridas disponiveis' : 'Pedidos enviados');
$secondaryMetric = $isAdmin ? 'Pedidos ativos' : ($isDeliverer ? 'Rotas aceitas' : 'Coletas agendadas');
$profileIcon = $isAdmin ? 'bi-shield-check' : ($isDeliverer ? 'bi-scooter' : 'bi-box-seam');
$profileRole = $isAdmin ? 'Administrador' : $this->current_user->userTypeLabel();
$profileClass = $isAdmin ? 'role-admin' : ($isDeliverer ? 'role-deliverer' : 'role-client');
?>

<section class="delivery-hero mb-3">
    <div class="delivery-hero-content">
        <span class="status-chip mb-3">
            <i class="bi <?= $profileIcon ?>"></i> <?= $profileRole ?>
        </span>
        <h1 class="fw-bold mb-2">Ola, <?= htmlspecialchars($this->current_user->name) ?>.</h1>
        <p class="mb-0"><?= $heroText ?></p>
    </div>
    <img class="delivery-hero-mobilete" src="/assets/images/mobilete.svg" alt="Mobilete em rota">
</section>

<section class="metric-grid mb-3">
    <div class="metric-tile">
        <span><?= $primaryMetric ?></span>
        <strong><?= $isDeliverer && !$isAdmin ? $pendingOrders : $totalOrders ?></strong>
    </div>
    <div class="metric-tile">
        <span><?= $secondaryMetric ?></span>
        <strong><?= $activeOrders ?></strong>
    </div>
    <div class="metric-tile">
        <span><?= $isDeliverer && !$isAdmin ? 'Entregas finalizadas' : 'Pedidos entregues' ?></span>
        <strong><?= $deliveredOrders ?></strong>
    </div>
</section>

<section class="profile-panel profile-summary">
    <div class="profile-summary-head mb-3">
        <div class="profile-avatar <?= $profileClass ?>">
            <i class="bi <?= $profileIcon ?>"></i>
        </div>
        <div>
            <div class="profile-label">Perfil de acesso</div>
            <h2 class="h5 mb-1"><?= $profileRole ?></h2>
            <span class="role-pill <?= $profileClass ?>">
                <i class="bi <?= $profileIcon ?>"></i> <?= $profileRole ?>
            </span>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12 col-sm-6">
            <div class="profile-label">Nome</div>
            <div class="fw-semibold"><?= htmlspecialchars($this->current_user->name) ?></div>
        </div>
        <div class="col-12 col-sm-6">
            <div class="profile-label">E-mail</div>
            <div class="fw-semibold text-break"><?= htmlspecialchars($this->current_user->email) ?></div>
        </div>
        <?php if ($this->current_user->birth_date) : ?>
        <div class="col-12 col-sm-6">
            <div class="profile-label">Nascimento</div>
            <div class="fw-semibold"><?= date('d/m/Y', strtotime($this->current_user->birth_date)) ?></div>
        </div>
        <?php endif; ?>
        <div class="col-12 col-sm-6">
            <div class="profile-label">Tipo de usuario</div>
            <div class="fw-semibold"><?= $this->current_user->userTypeLabel() ?></div>
        </div>
        <?php if ($this->current_user->isAdmin()) : ?>
        <div class="col-12 col-sm-6">
            <div class="profile-label">Permissao</div>
            <div class="fw-semibold">Administrador</div>
        </div>
        <?php endif; ?>
    </div>
    <div class="mt-3">
        <a class="btn btn-success" href="<?= route('orders.index') ?>">
            <i class="bi bi-receipt"></i> Ver pedidos
        </a>
    </div>
</section>
