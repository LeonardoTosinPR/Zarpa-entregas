#!/bin/bash

set -o errexit
set -o pipefail

source .env

# Wrapper to support environments without the `docker compose` subcommand.
# If the script calls `docker compose ...` this function will try the
# new `docker compose` first and fall back to `docker-compose` if needed.
function docker() {
    if [ "$1" = "compose" ]; then
        shift
        if command docker compose version >/dev/null 2>&1; then
            command docker compose "$@"
        elif command -v docker-compose >/dev/null 2>&1; then
            command docker-compose "$@"
        else
            echo "Error: neither 'docker compose' nor 'docker-compose' available. Install docker compose plugin or docker-compose." >&2
            return 1
        fi
    else
        command docker "$@"
    fi
}

function ps {
    docker compose ps
}

function up {
    docker compose up "${@}"
}

function down {
    docker compose down "${@}"
}

function composer {
    docker run --rm --interactive \
        -e COMPOSER_CACHE_DIR="/app/.cache/composer" \
        -u "$(id -u):$(id -g)" -v "$(pwd):/app" \
        -w /app composer:2.7.2 composer "${@}"
}

function nginx:check {
    docker compose exec web nginx -t
}

function nginx:status {
    docker compose exec web service nginx status
}

function nginx:reload {
    docker compose exec web nginx -s reload
}

function php:console {
    docker compose exec php php -a
}

function test {
    TEST_PATH="${@:-tests}"
    docker compose run --rm php_test ./vendor/bin/phpunit \
      --color=always \
      --testdox \
      ${TEST_PATH}
}

function codecept {
    docker compose run --rm php_test ./vendor/bin/codecept ${@}
}

function test:browser {
    TEST_PATH="${@:-tests/Acceptance}"
    docker compose run --rm php_test ./vendor/bin/codecept run acceptance ${TEST_PATH}
}

function phpcs {
    TEST_PATH="${@:-.}"
    docker compose run --rm php ./vendor/bin/phpcs ${TEST_PATH}
}

function phpcbf {
    TEST_PATH="${@:-.}"
    docker compose run --rm php ./vendor/bin/phpcbf ${TEST_PATH}
}

function phpstan {
    TEST_PATH="${@:-}"
    docker compose run --rm php ./vendor/bin/codecept build
    docker compose run --rm php ./vendor/bin/phpstan analyse --memory-limit 1G ${TEST_PATH}
}

function git:clean:branchs {
    git branch | grep -v '\*\|master\|main\|develop\|production' | xargs -n 1 git branch -D
}

function db:console {
    docker compose exec db sh -c "MYSQL_PWD=${DB_PASSWORD} mysql -u ${DB_USERNAME} ${DB_DATABASE} --default-character-set utf8mb4"
}

function db:reset {
    # Stream the schema into the container (avoid relying on `docker compose cp`)
    # Use -T to disable pseudo-TTY so this works when invoked via sudo
    docker compose exec -T db sh -c "cat > /tmp/schema.sql" < database/schema.sql
    docker compose exec -T db sh -c "MYSQL_PWD=${DB_PASSWORD} mysql -u ${DB_USERNAME} ${DB_DATABASE} --default-character-set utf8mb4 < /tmp/schema.sql"
}

function db:populate {
    docker compose exec -T php php database/Populate/populate.php
}

TIMEFORMAT=$'\nTask completed in %3lR'
time ${@}
